{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ocarina of Resonance preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "category", "description", "parameters", "effects", "performance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "parameters": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "parameters"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "parameters": { "type": "object", "additionalProperties": { "type": "number" } }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "voiceMode", "voiceLimit", "gainCompensationDb"],
      "properties": {
        "model": { "enum": ["ceramicAuthentic", "retroFantasy", "crystalResonator", "electronicHybrid"] },
        "voiceMode": { "enum": ["mono", "poly"] },
        "voiceLimit": { "type": "integer", "minimum": 1 },
        "gainCompensationDb": { "type": "number" }
      }
    }
  }
}
