{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ocarina of Resonance preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "category", "description", "parameters", "effects", "performance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": { "type": "string", "minLength": 1, "maxLength": 48 },
    "description": { "type": "string", "maxLength": 320 },
    "parameters": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "effects": {
      "type": "array",
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "parameters"],
        "properties": {
          "id": { "enum": ["filter", "drive", "fm", "grain", "tremolo", "phaser", "chorus", "crusher", "reducer", "delay", "reverb"] },
          "enabled": { "type": "boolean" },
          "parameters": { "type": "object", "additionalProperties": { "type": "number" } }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "voiceMode", "voiceLimit", "gainCompensationDb"],
      "properties": {
        "model": { "enum": ["ceramicAuthentic", "retroFantasy", "crystalResonator", "electronicHybrid"] },
        "voiceMode": { "enum": ["mono", "poly"] },
        "voiceLimit": { "type": "integer", "minimum": 1, "maximum": 16 },
        "gainCompensationDb": { "type": "number", "minimum": -18, "maximum": 6 },
        "tempoBpm": { "type": "number", "minimum": 40, "maximum": 250 }
      }
    }
  }
}
